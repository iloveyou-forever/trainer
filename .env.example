# Обязательно
BASE_URL=https://ваш-домен.example      # адрес сайта, нужен для ссылок в письмах
ADMIN_CODE=придумайте-длинный-случайный-код   # им вы регистрируете первого администратора

# ИИ-анализ по фото (платный ключ с console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
AI_DAILY_LIMIT=3                         # анализов по фото в сутки (бесплатные)
AI_PRO_LIMIT=30                          # то же для Pro
NUTRITION_DAILY_LIMIT=5                  # планов питания в сутки (Pro)
PRO_BUY_URL=                             # https-ссылка, куда вести за оплатой Pro

# Письма для сброса пароля (необязательно; без них ссылка пишется в лог сервера)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Где хранить базу (на хостинге укажите путь к постоянному диску)
DATA_DIR=./data
